.DS_Store
info.plist

# Xcode per-user state (window layout, breakpoints, scheme order).
# Churns on every Xcode launch and blocks pulls. Never belongs in git.
xcuserdata/
*.xcuserstate

# Firebase service account keys (seed scripts)
seed_bob_key*.json
serviceAccountKey*.json
*firebase-adminsdk*.json

# Federated learning (Python venv, caches, local env, firebase CLI state)
federated-learning/functions-ml/venv/
federated-learning/**/__pycache__/
*.local
federated-learning/.firebase/
federated-learning/**/*.parquet
federated-learning/**/*.pkl
federated-learning/**/*.mlmodel
federated-learning/**/*.mlpackage
federated-learning/**/node_modules/
federated-learning/**/.pytest_cache/
firebase-debug.log
firestore-debug.log
